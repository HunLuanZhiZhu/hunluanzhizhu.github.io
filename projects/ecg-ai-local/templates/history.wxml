<!-- history.wxml — Warm Clinical -->
<!-- H6: 编辑模式下给 container 加 padding-bottom，避免 bottom-delete-bar 遮挡列表 -->
<!-- page-meta: 深色模式下同步 page 元素背景色, 防止页面边缘/回弹时露出浅色底 -->
<page-meta page-style="background: {{theme === 'dark' ? '#0B1120' : '#F5F5F7'}}" />
<view class="container {{theme === 'dark' ? 'dark' : ''}} {{editMode ? 'edit-padding-bottom' : ''}}">

  <!-- 骨架屏: 首载占位(统计卡+趋势+列表), 数据就绪后与首帧setData同批替换 -->
  <block wx:if="{{loading}}">
    <view class="sk sk-stat"></view>
    <view class="sk-card">
      <view class="sk sk-line sk-line-40"></view>
      <view class="sk-bars">
        <view class="sk sk-bar" wx:for="{{[1,2,3,4,5,6,7]}}" wx:key="*this"></view>
      </view>
    </view>
    <view class="sk-card">
      <view class="sk-row" wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
        <view class="sk sk-avatar"></view>
        <view class="sk-lines">
          <view class="sk sk-line"></view>
          <view class="sk sk-line sk-line-40"></view>
        </view>
      </view>
    </view>
  </block>

  <view class="page-head fade-in-up" wx:if="{{historyList.length > 0}}">
    <view class="page-eyebrow">检测记录</view><view class="page-title">检测历史</view>
  </view>
  <view class="logo-card fade-in-up-d1" wx:if="{{historyList.length > 0}}"><image class="logo-card-img" src="/assets/logo.jpg" mode="aspectFill"></image><view class="logo-card-text"><view class="logo-card-title">心韵深辨</view><view class="logo-card-sub">心跳有迹可循 · 趋势/分布/风险一目了然</view></view></view>

  <view class="stat-hero fade-in-up-d1" wx:if="{{historyList.length > 0}}">
    <view class="stat-hero-item"><view class="stat-hero-val">{{totalCount}}</view><view class="stat-hero-lbl">总检测</view></view>
    <view class="stat-hero-div"></view>
    <view class="stat-hero-item"><view class="stat-hero-val green">{{normalCount}}</view><view class="stat-hero-lbl">正常</view></view>
    <view class="stat-hero-div"></view>
    <view class="stat-hero-item"><view class="stat-hero-val red">{{abnormalCount}}</view><view class="stat-hero-lbl">异常</view></view>
  </view>

  <view class="trend-card fade-in-up-d2" wx:if="{{historyList.length > 0}}"><view class="trend-header"><view class="trend-title">7天检测趋势</view><view class="trend-rate" wx:if="{{trendNormalRate > 0}}">{{trendNormalRate}}% 正常</view></view>
    <view class="trend-chart"><view class="trend-bar-col" wx:for="{{trendData}}" wx:key="date"><view class="trend-bar bar-grow-y {{item.hasAbnormal ? 'trend-bar-abnormal' : 'trend-bar-normal'}}" style="height:{{item.height}}px; animation-delay:{{index * 0.04}}s;"></view><view class="trend-bar-label">{{item.label}}</view></view></view></view>

  <view class="donut-card fade-in-up-d3" wx:if="{{historyList.length > 0}}"><view class="donut-header"><view class="donut-title">心律分类统计</view></view>
    <view class="donut-body"><view class="donut-ring" style="background:{{donutGradient}};"><view class="donut-center"><view class="donut-center-val">{{totalCount}}</view><view class="donut-center-lbl">总计</view></view></view>
      <view class="donut-legend"><view class="legend-item" wx:for="{{categoryStats}}" wx:key="abbr"><view class="legend-dot legend-dot-{{item.abbr}}"></view><view class="legend-name">{{item.name}}</view><view class="legend-val">{{item.count}}</view></view></view></view></view>

  <view class="risk-card risk-card-{{riskLevel}} fade-in-up-d4" wx:if="{{historyList.length > 0}}"><view class="risk-icon risk-icon-{{riskLevel}}">{{riskIcon}}</view><view class="risk-info"><view class="risk-level risk-level-{{riskLevel}}">{{riskLevelText}}</view><view class="risk-desc">{{riskDesc}}</view></view></view>

  <!-- H3: 综合分析入口行用 list-icon list-icon-teal + 文字"析" 替换 emoji -->
  <view class="list-group" wx:if="{{historyList.length > 0}}"><view class="list-row" bindtap="onGoAnalysis"><view class="list-icon list-icon-teal">析</view><view class="list-content"><view class="list-title">综合分析</view><view class="list-desc">查看检测数据统计与健康建议</view></view><view class="tag tag-orange" wx:if="{{analysis}}">{{analysis.riskLevel}}风险</view><view class="list-arrow">›</view></view></view>

  <view class="compact-actions" wx:if="{{historyList.length > 0}}"><view class="compact-action-btn compact-action-manage" bindtap="onToggleEdit">{{editMode ? '完成' : '管理'}}</view><view class="compact-action-btn compact-action-export" bindtap="onExportHistory">导出</view><view class="compact-action-btn compact-action-clear" bindtap="onClearHistory">清空</view></view>

  <view class="sec" wx:if="{{historyList.length > 0}}"><view class="sec-title">检测记录</view></view>
  <!-- 日期分组: 今天/昨天/更早 组头+组内记录 -->
  <view class="list-group" wx:if="{{historyList.length > 0}}">
    <block wx:for="{{groupedHistory}}" wx:key="label" wx:for-item="group">
      <view class="list-group-head">{{group.label}} · {{group.items.length}} 条</view>
      <view class="list-row stagger-item {{editMode ? 'edit-mode' : ''}}" wx:for="{{group.items}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap" style="animation-delay:{{(index > 8 ? 8 : index) * 0.03}}s;">
        <view class="check-box {{item.checked ? 'checked' : ''}}" wx:if="{{editMode}}"><view class="check-mark" wx:if="{{item.checked}}">✓</view></view>
        <view class="list-badge list-badge-{{item.classAbbr}}">{{item.classAbbr}}</view>
        <view class="list-content"><view class="list-title">{{item.timeStr}}</view><view class="list-desc">{{item.className}}</view></view>
        <view class="tag {{item.isAbnormal ? 'tag-abnormal' : 'tag-normal'}}" wx:if="{{!editMode}}">{{item.isAbnormal ? '异常' : '正常'}}</view>
        <view class="list-meta" wx:if="{{!editMode}}"><view class="list-meta-val">{{item.confidencePercent}}%</view><view class="list-meta-lbl">置信度</view></view>
        <view class="list-arrow" wx:if="{{!editMode}}">›</view>
      </view>
    </block>
  </view>

  <view class="bottom-delete-bar" wx:if="{{editMode && historyList.length > 0}}"><view class="select-all-btn" bindtap="onToggleSelectAll">{{allChecked ? '取消全选' : '全选'}}</view><view class="delete-selected-btn {{selectedCount > 0 ? 'active' : ''}}" bindtap="onDeleteSelected">删除选中{{selectedCount > 0 ? '(' + selectedCount + ')' : ''}}</view></view>

  <view class="empty-state ecg-bg-line" wx:if="{{!loading && historyList.length === 0}}"><view class="empty-icon empty-icon-text">记</view><view class="empty-text">暂无检测记录</view><view class="empty-subtext">完成心电检测后，记录将显示在此处</view><view class="empty-action-btn" bindtap="onGoDetect">去检测</view></view>
  <view class="footer-text" wx:if="{{historyList.length > 0}}">心韵深辨 · 用心感知，以智辨析</view>
</view>
