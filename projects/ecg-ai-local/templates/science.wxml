<!-- science.wxml — Warm Clinical
  * Sc2: AAMI 分类卡内联 style 提取到 class
  * Sc4: 分类卡添加左侧装饰条(item.accentClass)
  * Sc5: 健康提示使用全局 health-tip 类
  * Sc6: 第4条警示提示用 health-tip-warning(amber)
  * Sc9: 搜索无结果时显示空状态
  * Sc11: 分类卡波形背景用浅色 class
  * Sc12: 精选科普轮播(swiper自动播放+自定义指示器) + 返回顶部
-->
<!-- page-meta: 深色模式下同步 page 元素背景色, 防止页面边缘/回弹时露出浅色底 -->
<page-meta page-style="background: {{theme === 'dark' ? '#0B1120' : '#F5F5F7'}}" />
<view class="container {{theme === 'dark' ? 'dark' : ''}}">
  <view class="page-head fade-in-up"><view class="page-eyebrow">知识库</view><view class="page-title">心律科普</view></view>
  <view class="logo-card fade-in-up-d1"><image class="logo-card-img" src="/assets/logo.jpg" mode="aspectFill"></image><view class="logo-card-text"><view class="logo-card-title">心韵深辨</view><view class="logo-card-sub">从P波到T波 · 一站式读懂你的心电图</view></view></view>

  <view class="search-bar fade-in-up-d1"><view class="search-bar-icon-css"></view><input class="search-bar-input" placeholder="搜索科普文章" confirm-type="search" bindinput="onSearchInput" value="{{searchKeyword}}"/><view class="search-clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">✕</view></view>
  <view class="chip-row">
    <view class="chip {{activeCategory === '全部' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="全部">全部</view>
    <view class="chip {{activeCategory === '心律基础' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="心律基础">心律基础</view>
    <view class="chip {{activeCategory === '检测指南' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="检测指南">检测指南</view>
    <view class="chip {{activeCategory === '健康建议' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="健康建议">健康建议</view>
    <view class="chip {{activeCategory === '异常解读' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="异常解读">异常解读</view>
    <view class="chip {{activeCategory === '新技术' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="新技术">新技术</view>
  </view>

  <!-- 精选科普轮播: 原生swiper自动播放 + 自定义teal指示器(active变宽) -->
  <view class="feature-swiper-wrap fade-in-up-d1">
    <swiper class="feature-swiper" autoplay circular interval="4000" duration="500" bindchange="onFeatureChange" current="{{featureIndex}}">
      <swiper-item wx:for="{{featuredArticles}}" wx:key="id">
        <view class="feature-slide" bindtap="onFeaturedTap" data-id="{{item.id}}">
          <view class="feature-slide-cover">
            <image class="feature-slide-bg" src="{{item.coverImage}}" mode="aspectFill"></image>
            <view class="feature-slide-mask"></view>
            <view class="feature-slide-content">
              <view class="feature-slide-tag">精选 · {{item.category}}</view>
              <view class="feature-slide-title">{{item.title}}</view>
              <view class="feature-slide-desc">{{item.desc}}</view>
              <view class="feature-slide-cta">阅读文章 ›</view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="feature-dots">
      <view class="feature-dot {{featureIndex === index ? 'active' : ''}}" wx:for="{{featuredArticles}}" wx:key="id" data-index="{{index}}" bindtap="onFeatureDot"></view>
    </view>
  </view>

  <view class="sec fade-in-up-d3"><view class="sec-title">科普文章</view></view>
  <!-- Sc9: 无搜索结果时显示空状态 -->
  <view class="empty-state ecg-bg-line" wx:if="{{filteredArticles.length === 0}}">
    <view class="empty-icon empty-icon-text">阅</view>
    <view class="empty-text">暂无文章</view>
    <view class="empty-subtext">没有找到匹配的科普文章，试试其他关键词</view>
  </view>
  <view class="article-card stagger-item" wx:for="{{filteredArticles}}" wx:key="id" data-id="{{item.id}}" bindtap="onArticleTap" style="animation-delay:{{0.08 + (index > 5 ? 5 : index) * 0.035}}s;">
    <view class="article-cover article-cover-{{item.cover}}">
      <view class="article-cover-tag">{{item.category}}</view>{{item.iconText}}
    </view>
    <view class="article-body">
      <view class="article-title">{{item.title}}</view>
      <view class="article-desc">{{item.desc}}</view>
      <view class="article-foot">
        <text class="article-author">{{item.author}}</text>
        <text class="article-time">{{item.readTime}}阅读 · {{item.time}}</text>
      </view>
    </view>
  </view>

  <view class="sec fade-in-up-d4"><view class="sec-title">AAMI 心律失常分类</view></view>
  <!-- 分类色卡速查条: 五类颜色+缩写+名称 一眼速查 -->
  <view class="card legend-strip-card fade-in-up-d4">
    <view class="legend-strip" wx:for="{{categories}}" wx:key="key">
      <view class="legend-strip-dot legend-dot-{{item.key}}"></view>
      <view class="legend-strip-abbr">{{item.key}}</view>
      <view class="legend-strip-name">{{item.name}}</view>
    </view>
  </view>
  <!-- Sc2/Sc4/Sc11: 分类卡使用提取的 class + 装饰条 + 浅色波形背景 -->
  <view class="card category-card stagger-item {{item.accentClass}}" wx:for="{{categories}}" wx:key="key" data-key="{{item.key}}" bindtap="onCategoryTap" style="animation-delay:{{0.06 + (index > 5 ? 5 : index) * 0.035}}s;">
    <view class="category-header">
      <view class="category-icon-wrap {{item.iconClass}}">{{item.key}}</view>
      <view class="category-name-wrap">
        <view class="category-name">{{item.name}}</view>
        <view class="category-en-name">{{item.enName}}</view>
      </view>
    </view>
    <view class="category-wave-bg"><canvas id="waveCanvas_{{item.key}}" type="2d" class="category-wave-canvas"></canvas></view>
    <view class="category-desc">{{item.desc}}</view>
  </view>

  <!-- Sc5/Sc6: 健康提示 — 前三条用 info(teal), 第4条警示用 warning(amber) -->
  <view class="card health-tip health-tip-info">
    <view class="health-tip-dot health-tip-dot-info">i</view>
    <view class="health-tip-content">
      <view class="health-tip-title">健康提示</view>
      <view class="health-tip-text">01 定期进行心电检查，尤其是40岁以上人群及有心血管疾病家族史者</view>
      <view class="health-tip-text">02 保持规律作息与适度运动，避免过度劳累和情绪波动</view>
      <view class="health-tip-text">03 如出现心悸、胸闷、头晕等不适症状，应及时就医并做心电图检查</view>
    </view>
  </view>
  <!-- Sc6: 警示性提示使用 warning(amber) 而非 teal -->
  <view class="card health-tip health-tip-warning">
    <view class="health-tip-dot health-tip-dot-warning">!</view>
    <view class="health-tip-content">
      <view class="health-tip-title">免责声明</view>
      <view class="health-tip-text">本应用检测结果仅供参考，不能替代专业医疗诊断</view>
    </view>
  </view>
  <view class="footer-text">心韵深辨 · 用心感知，以智辨析</view>

  <!-- 返回顶部: 滚动超过一屏后浮现 -->
  <view class="back-top {{showBackTop ? 'show' : ''}}" bindtap="onBackTop"><view class="back-top-icon">↑</view></view>
</view>
